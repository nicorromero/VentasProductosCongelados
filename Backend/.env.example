SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
MAIL_FROM=tu_correo@gmail.com
FRONTEND_URL=http://localhost:5173

# Reportes automáticos (node-cron + ExcelJS)
REPORT_EMAIL=admin@tudominio.com          # Destinatario del reporte. Si no se define, usa MAIL_FROM.
REPORT_CRON_SCHEDULE=59 23 * * *          # Cron schedule (default: todos los días a las 23:59 hora ARG)

# Sincronización Inteligente con Google Sheets API v4 (Google Drive)
# ID del documento (se obtiene de la URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit)
GOOGLE_SHEET_ID=1A2B3C4D5E6F7G8H9I0JkLmNoPqRsTuVwXyZ

# Opción A: Credenciales de Google Cloud Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=sync-ecommerce-service@tu-proyecto-gcp.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Opción B (Alternativa OAuth2 si tu organización bloquea Service Account Keys):
