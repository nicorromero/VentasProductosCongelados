# Cron Schedules (Zona horaria Argentina)
EXCEL_CIERRE_CRON_SCHEDULE=59 23 * * *      # Cierre de caja a Google Sheets (23:59 ARG)
EXCEL_PRECIOS_CRON_SCHEDULE=0 6 * * *       # Lectura de precios sugeridos de Google Sheets (06:00 ARG)